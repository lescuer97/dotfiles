{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git commit*": "deny"
    }
  },
  "plugin": ["opencode-mem@v2.29.2"],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp"
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@1.12.0",
          "--executablePath",
          "/Applications/Chromium.app/Contents/MacOS/Chromium",
          "--isolated",
          "--no-usage-statistics",
          "--no-performance-crux",
          "--redact-network-headers"
        ],
        "environment": {
          "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
        }
      },
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp"
      }
    }
  },
  "provider": {
    "ppq": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ppq",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1",
        "includeUsage": true
      },
      "models": {
        "private/glm-5-3-flash": {
          "name": "GLM-5.3 Flash (Private via TEE)"
        },
        "google/gemini-4-argon": {
          "name": "Gemini 4 Argon"
        },
        "private/glm-5-3": {
          "name": "GLM-5.3 (Private via TEE)"
        },
        "private/kimi-k3": {
          "name": "Kimi K3 (Private via TEE)"
        },
        "private/deepseek-v4-1-flash": {
          "name": "DeepSeek V4.1 Flash (Private via TEE)"
        },
        "x-ai/grok-code-fast-1": {
          "name": "x-ai/grok-code-fast-1"
        },
        "anthropic/claude-sonnet-4": {
          "name": "anthropic/claude-sonnet-4"
        },
        "anthropic/claude-sonnet-4.5": {
          "name": "anthropic/claude-sonnet-4.5"
        },
        "claude-sonnet-4.6": {

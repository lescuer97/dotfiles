{
  "extends": "opencode",
  "meta": {
    "name": "numes-opencode",
    "version": "1.0.0",
    "description": "opencode launched through numes, with Chromium for the chrome-devtools MCP; small network allowlist"
  },
  "filesystem": {
    "allow": ["$HOME/.config/numes", "$HOME/.local/share/numes", "$HOME/.cache/chrome-devtools-mcp"],
    "read": ["$HOME/.local/bin/numes", "/Applications/Chromium.app"]
  },
  "platform_overrides": {
    "macos": {
      "command_policies": {
        "commands": {
          "git": {
            "executable": "/opt/homebrew/bin/git"
          }
        }
      }
    }
  },
  "network": {
    "allow_domain": [
      "api.numes.ai",
      "auth.numes.ai",
      "releases.numes.ai",
      "numes.ai",
      "models.dev",
      "registry.npmjs.org",
      "mcp.context7.com",
      "mcp.notion.com",
      "mcp.figma.com",
      "imagekit.io",
      "chatgpt.com",
      "auth.openai.com",
      "api.openai.com",
      "vercel.com",
      "vercel.app",
      "*.vercel.app",
      "bubblydoo.be",
      "*.bubblydoo.be",
      "bubblydoo.cz",
      "*.bubblydoo.cz",
      "bubblydoo.nl",
      "*.bubblydoo.nl",
      "bubblydoo.de",
      "*.bubblydoo.de",
      "bubblydoo.fr",
      "*.bubblydoo.fr",
      "bubblydoo.uk",
      "*.bubblydoo.uk",
      "bubblydoo.it",
      "*.bubblydoo.it",
      "bubblydoo.us",
      "*.bubblydoo.us",
      "bubblydoo.es",
      "*.bubblydoo.es",
      "bubblydoo.quebec",
      "*.bubblydoo.quebec",
      "bubblydoo.co",
      "*.bubblydoo.co",
      "bubblydoo.se",
      "*.bubblydoo.se",
      "bubblydoo.pl",
      "*.bubblydoo.pl",
      "bubblydoo.ch",
      "*.bubblydoo.ch",
      "bubblydoo.at",
      "*.bubblydoo.at",
      "bubblydoo.mx",
      "*.bubblydoo.mx",
      "bubblydoo.nz",
      "*.bubblydoo.nz",
      "bubblydoo.jp",
      "*.bubblydoo.jp",
      "bubblydoo.ie",
      "*.bubblydoo.ie",
      "bubblydoo.pt",
      "*.bubblydoo.pt",
      "bubblydoo.sk",
      "*.bubblydoo.sk",
      "bubblydoo.sg",
      "*.bubblydoo.sg",
      "bubblydoo.in",
      "*.bubblydoo.in",
      "bubblydoo.studio",
      "*.bubblydoo.studio"
    ],
    "no_proxy": ["localhost", "127.0.0.1"],
    "open_port": [0]
  }
}
